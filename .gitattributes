# Normalize all text files to LF in the repository; Git auto-detects binary.
# This silences per-machine autocrlf line-ending warnings across the team
# (e.g. "LF will be replaced by CRLF the next time Git touches it").
* text=auto eol=lf

# --- .NET / Razor source: LF ---
*.cs          text eol=lf
*.cshtml      text eol=lf
*.razor       text eol=lf
*.sql         text eol=lf
*.json        text eol=lf
*.xml         text eol=lf
*.md          text eol=lf
*.txt         text eol=lf
*.webmanifest text eol=lf

# --- Frontend source: LF ---
*.js          text eol=lf
*.jsx         text eol=lf
*.ts          text eol=lf
*.tsx         text eol=lf
*.css         text eol=lf
*.scss        text eol=lf
*.svg         text eol=lf
*.html        text eol=lf

# --- Build and tooling files: LF, like everything else ---
#
# These were declared CRLF on the grounds that "PowerShell / MSBuild prefer it". Neither
# does: MSBuild and PowerShell both read LF fine on Windows, and the index has been LF for
# all of them the whole time. What the CRLF declaration actually produced was a working tree
# git could never leave alone: 11 csproj files checked out CRLF, 3 LF, and a "LF will be
# replaced by CRLF" warning on every touch of a file that was already correct.
#
# The house rule is LF everywhere, with .bat and .cmd the only files that genuinely need
# CRLF (a batch file with LF line endings can misbehave in cmd.exe).
# Add the override back alongside a .bat, not ahead of one.
*.ps1         text eol=lf
*.csproj      text eol=lf
*.sqlproj     text eol=lf
*.slnx        text eol=lf

# --- Binary assets: never touch line endings / no text diff ---
*.jpg   binary
*.jpeg  binary
*.png   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
