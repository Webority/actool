{
  "$schema": "~/.claude/schemas/settings.schema.json",
  "schemaVersion": 1,
  "engineeringProjectId": 156,
  "owner": {
    "type": "webority",
    "pushOrgs": [
      "Webority"
    ]
  },
  "kind": "tool",
  "stacks": [
    "rust"
  ],
  "release": {
    "mode": "manual",
    "speed": "normal"
  },
  "staging": {
    "deploy": "on-word"
  },
  "commands": {
    "checks": "node ~/.claude/scripts/ratchet.js",
    "verify": "cargo fmt --all --check && cargo clippy --all-targets --locked -- -D warnings && cargo test --locked -q",
    "buildLogChecks": "node ~/.claude/scripts/ratchet.js --build-log \"$GIT_SYNC_BUILD_LOG\""
  },
  "git": {
    "prPolicy": "release-only",
    "branches": {
      "working": "development",
      "release": "main"
    }
  }
}
